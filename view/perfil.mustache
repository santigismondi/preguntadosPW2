{{>header}}

<main class="perfil-page">
    <div class="overlay"></div>

    <section class="perfil-card">

        <div class="perfil-header">
            <img src="{{baseUrl}}/public/img/usuarios/{{usuario.foto_perfil}}"
                 onerror="if(this.src !== '{{baseUrl}}/public/img/usuarios/default.png') this.src='{{baseUrl}}/public/img/usuarios/default.png'; else this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 200 200%22%3E%3Crect fill=%22%23e0e0e0%22 width=%22200%22 height=%22200%22/%3E%3Ccircle cx=%22100%22 cy=%2270%22 r=%2240%22 fill=%22%23999%22/%3E%3Crect x=%2260%22 y=%22130%22 width=%2280%22 height=%2270%22 fill=%22%23999%22/%3E%3C/svg%3E'"
                 alt="Foto de perfil"
                 class="perfil-foto">

            <h1>{{usuario.nombre_usuario}}</h1>
            <p>{{usuario.nombre}}</p>
        </div>

        <div class="perfil-stats">
            <div class="stat-box">
                <span>⭐ {{puntajeMaximo}}</span>
                <p>Mejor puntaje</p>
            </div>

            <div class="stat-box">
                <span>🎮 {{cantidadPartidas}}</span>
                <p>Partidas realizadas</p>
            </div>
        </div>

        <div class="perfil-section">
            <h2>Datos del jugador</h2>
            <p><strong>Ubicación:</strong> {{usuario.coordenadas_ciudad}}</p>
        </div>

        <div class="perfil-section perfil-qr">
            <h2>QR del perfil</h2>
            <img src="{{qrUrl}}" alt="QR del perfil">
        </div>

        <div class="perfil-section">
            <h2>Partidas</h2>

            {{#partidas}}
                <div class="partida-card">
                    <h3>Partida #{{id}}</h3>
                    <p><strong>Puntaje:</strong> {{puntaje}}</p>
                    <p><strong>Resultado:</strong> {{resultado}}</p>
                </div>
            {{/partidas}}

            {{^partidas}}
                <p class="sin-partidas">Todavía no hay partidas realizadas.</p>
            {{/partidas}}
        </div>

        <div class="perfil-botones">
            <a href="{{baseUrl}}/lobby/ver" class="btn-perfil btn-volver">Volver al lobby</a>
            <a href="{{baseUrl}}/usuario/logout" class="btn-perfil btn-salir">Cerrar sesión</a>
        </div>

    </section>
</main>

{{>footer}}