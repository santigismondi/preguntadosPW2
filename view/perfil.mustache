{{>header}}

<div class="overlay"></div>

<main class="perfil-page">

    <section class="perfil-card">

        <header class="perfil-hero">

            <div class="perfil-identidad">

                <div class="perfil-foto-wrapper">
                    <img
                        src="{{baseUrl}}/public/img/usuarios/{{usuario.foto_perfil}}"
                        onerror="this.src='{{baseUrl}}/public/img/usuarios/default.png'; this.onerror=null;"
                        alt="Foto de perfil de {{usuario.nombre_usuario}}"
                        class="perfil-foto">
                </div>

                <div class="perfil-copy">
                    <span class="perfil-eyebrow">
                        {{tituloPerfil}}
                    </span>

                    <h1>{{usuario.nombre_usuario}}</h1>

                    <p>{{usuario.nombre}}</p>
                </div>

            </div>

            <div class="perfil-resumen">

                <article class="perfil-stat">
                    <span class="perfil-stat__label">
                        Mejor puntaje
                    </span>

                    <strong>
                        {{puntajeMaximo}}
                    </strong>

                    <small>
                        récord personal
                    </small>
                </article>

                <article class="perfil-stat">
                    <span class="perfil-stat__label">
                        Partidas
                    </span>

                    <strong>
                        {{cantidadPartidas}}
                    </strong>

                    <small>
                        jugadas
                    </small>
                </article>

            </div>

        </header>

        <div class="perfil-grid">

            <section class="perfil-panel perfil-datos">

                <div class="perfil-panel__header">
                    <span>Información</span>
                    <h2>Datos del jugador</h2>
                </div>

                <div class="perfil-info-list">

                    <div class="perfil-info-item">
                        <span>Nombre</span>
                        <strong>{{usuario.nombre}}</strong>
                    </div>

                    <div class="perfil-info-item">
                        <span>Usuario</span>
                        <strong>{{usuario.nombre_usuario}}</strong>
                    </div>

                    <div class="perfil-info-item">
                        <span>Ubicación</span>
                        <strong>{{usuario.localidad}}</strong>
                    </div>

                </div>

            </section>

            <section class="perfil-panel perfil-qr">

                <div class="perfil-panel__header">
                    <span>Compartir perfil</span>
                    <h2>Código QR</h2>
                </div>

                <div class="perfil-qr-box">
                    <img
                        src="{{qrUrl}}"
                        alt="Código QR del perfil de {{usuario.nombre_usuario}}">
                </div>

                <p class="perfil-qr-texto">
                    Escaneá este código para abrir el perfil del jugador.
                </p>

            </section>

        </div>

        <section class="perfil-panel perfil-partidas">

            <div class="perfil-panel__header perfil-panel__header--row">

                <div>
                    <span>Historial</span>
                    <h2>Partidas realizadas</h2>
                </div>

                <div class="perfil-partidas-total">
                    {{cantidadPartidas}} partidas
                </div>

            </div>

            {{#partidas}}
            <article class="partida-card">

                <div class="partida-card__principal">
                    <span>Partida</span>
                    <strong>#{{id}}</strong>
                </div>

                <div class="partida-card__dato">
                    <span>Puntaje</span>
                    <strong>{{puntaje}}</strong>
                </div>

                <div class="partida-card__dato">
                    <span>Resultado</span>
                    <strong class="partida-resultado">
                        {{resultado}}
                    </strong>
                </div>

            </article>
            {{/partidas}}

            {{^partidas}}
            <div class="sin-partidas">
                <strong>Sin partidas registradas</strong>

                <p>
                    Este jugador todavía no tiene partidas realizadas.
                </p>
            </div>
            {{/partidas}}

        </section>

    </section>

</main>

{{>footer}}