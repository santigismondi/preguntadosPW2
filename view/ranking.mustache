{{>header}}

<div class="overlay"></div>

<main class="contenido ranking-page">
    <section class="page-card ranking-card">
        <div class="ranking-header">
            <span class="eyebrow">Clasificación general</span>
            <h1 class="titulo">Ranking global</h1>
            <p class="bienvenida">
                Los mejores puntajes de Preguntados Mundial 2026.
            </p>
        </div>

        <div class="ranking-table-wrapper">
            <table class="ranking-table">
                <thead>
                    <tr>
                        <th>Posición</th>
                        <th>Jugador</th>
                        <th>Mejor puntaje</th>
                    </tr>
                </thead>

                <tbody>
                    {{#ranking}}
                    <tr>
                        <td>
                            <span class="ranking-position">#{{posicion}}</span>
                        </td>

                        <td>
                            <a href="{{baseUrl}}/perfil/ver?id={{id}}" class="ranking-player">
                                {{nombre_usuario}}
                            </a>
                        </td>

                        <td>
                            <strong class="ranking-score">{{mejor_puntaje}}</strong>
                        </td>
                    </tr>
                    {{/ranking}}
                </tbody>
            </table>
        </div>
    </section>
</main>

{{>footer}}