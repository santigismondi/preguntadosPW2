<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{titulo}}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <link rel="stylesheet" href="{{baseUrl}}/public/css/estilos.css">

    {{#cssExtra}}
        <link rel="stylesheet" href="{{cssExtra}}">
    {{/cssExtra}}
</head>
<body>
{{#showAppHeader}}
<header class="app-header app-header--{{headerVariant}}" {{#headerSurfaceStyle}}style="{{headerSurfaceStyle}}"{{/headerSurfaceStyle}}>
    <div class="app-header__inner">
        <div class="app-header__left">
            {{#showBackToLobby}}
                <a href="{{backToLobbyUrl}}" class="app-header__action app-header__action--back">
                    ← Volver al lobby
                </a>
            {{/showBackToLobby}}
        </div>

        <div class="app-header__center">
            {{#showAppBrand}}
                <a href="{{headerBrandUrl}}" class="app-header__brand">
                    <img src="{{headerLogo}}" alt="Logo de {{headerTitle}}" class="app-header__logo">
                    <span class="app-header__brand-title">{{headerTitle}}</span>
                </a>
            {{/showAppBrand}}

            {{#showPageTitle}}
                <h1 class="app-header__page-title">{{headerPageTitle}}</h1>
            {{/showPageTitle}}

            {{#showCategoryBadge}}
                <div class="app-header__category" style="--header-accent: {{headerCategoryColor}};">
                    <img src="{{headerCategoryIcon}}" alt="{{headerCategoryName}}" class="app-header__category-icon">
                    <div class="app-header__category-copy">
                        <span>Categoría</span>
                        <strong>{{headerCategoryName}}</strong>
                    </div>
                </div>
            {{/showCategoryBadge}}
        </div>

        <div class="app-header__right">
            {{#showProfileButton}}
                <a href="{{profileButtonUrl}}" class="app-header__action app-header__action--profile">
                    {{profileButtonLabel}}
                </a>
            {{/showProfileButton}}

            {{#showAdminButton}}
                <a href="{{adminUrl}}" class="app-header__action app-header__action--admin">
                    Panel de administración
                </a>
            {{/showAdminButton}}

            {{#showLogoutButton}}
                <a href="{{logoutUrl}}" class="app-header__action app-header__action--logout">
                    Cerrar sesión
                </a>
            {{/showLogoutButton}}
        </div>
    </div>
</header>
{{/showAppHeader}}
