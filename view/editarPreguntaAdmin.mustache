{{>header}}

<main class="admin-page">
    <section class="admin-container">
        <div class="admin-header">
            <div>
                <h1>Editar pregunta</h1>
                <p>Modificá la pregunta, sus opciones y cuál es la correcta.</p>
            </div>

            <a class="btn-print" href="{{baseUrl}}/index.php?controller=admin&method=ver">
                Volver
            </a>
        </div>

        <form class="admin-card form-editar-pregunta">
            <input type="hidden" name="id" value="{{preguntaId}}">

            <label>
                Pregunta
                <textarea name="pregunta" rows="4">{{pregunta}}</textarea>
            </label>

            <h2>Opciones</h2>

            {{#opciones}}
                <div class="opcion-editable-admin">
                    <input type="radio" name="opcion_correcta" value="{{id}}" {{#correcta}}checked{{/correcta}}>
                    <input type="text" name="opciones[{{id}}]" value="{{texto}}">
                </div>
            {{/opciones}}

            <div class="modal-actions">
                <button type="submit" class="btn-revisada">Guardar cambios</button>
                <a class="btn-danger" href="{{baseUrl}}/index.php?controller=admin&method=ver">Cancelar</a>
            </div>
        </form>
    </section>
</main>

{{>footer}}