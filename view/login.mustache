<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>{{titulo}}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="{{baseUrl}}/public/css/estilos.css">
</head>
<body class="auth-body">

<main class="auth-page auth-page--login">

    <section class="auth-card auth-card--login">

        <header class="auth-header">

            <div class="auth-logo-container">
                <img
                    src="{{baseUrl}}/public/img/logo.png"
                    alt="Preguntados Mundial 2026"
                    class="auth-logo">
            </div>

            <span class="auth-eyebrow">
                Edición mundial
            </span>

            <h1>Preguntados Mundial 2026</h1>

            <p>
                Ingresá a tu cuenta y demostrá cuánto sabés de fútbol.
            </p>

        </header>

        {{#error}}
        <div class="auth-alert">
            {{error}}
        </div>
        {{/error}}

        <form
            action="{{baseUrl}}/usuario/procesarLogin"
            method="POST"
            class="auth-form">

            <div class="auth-field">
                <label for="nombre_usuario">
                    Usuario
                </label>

                <input
                    type="text"
                    id="nombre_usuario"
                    name="nombre_usuario"
                    placeholder="Ingresá tu usuario"
                    autocomplete="username"
                    required>
            </div>

            <div class="auth-field">
                <label for="contrasena">
                    Contraseña
                </label>

                <input
                        type="password"
                        id="contrasena"
                        name="contrasena"
                        placeholder="Ingresá tu contraseña"
                        autocomplete="current-password"
                        required>
            </div>

            <button
                type="submit"
                class="auth-submit">

                Ingresar
            </button>

        </form>

        <div class="auth-secondary">
            <span>¿Todavía no tenés una cuenta?</span>

            <a href="{{baseUrl}}/usuario/registro">
                Crear cuenta
            </a>
        </div>

    </section>

</main>

</body>
</html>