<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>{{titulo}}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="{{baseUrl}}/public/css/estilos.css">
</head>

<body class="auth-body">

<main class="auth-page auth-page--login">

    <section class="auth-card auth-card--login">

        <header class="auth-header">

            <div class="auth-logo-container">
                <img
                    src="{{baseUrl}}/public/img/logo.png"
                    alt="Preguntados Mundial 2026"
                    class="auth-logo">
            </div>

            <span class="auth-eyebrow">
                Edición mundial
            </span>

            <h1>Preguntados Mundial 2026</h1>

            <p>
                Ingresá a tu cuenta y demostrá cuánto sabés de fútbol.
            </p>

        </header>

        {{#error}}
        <div class="auth-alert">
            {{error}}
        </div>
        {{/error}}

        <form
            action="{{baseUrl}}/usuario/procesarLogin"
            method="POST"
            class="auth-form">

            <div class="auth-field">
                <label for="nombre_usuario">
                    Usuario
                </label>

                <input
                    type="text"
                    id="nombre_usuario"
                    name="nombre_usuario"
                    placeholder="Ingresá tu usuario"
                    autocomplete="username"
                    required>
            </div>

            {{#mensaje_exito}}
                <div class="alert alert-success text-center py-2 fw-semibold">
                    {{mensaje_exito}}
                </div>
            {{/mensaje_exito}}

            {{#error}}
                <div class="alert alert-danger text-center py-2 fw-semibold">
                    {{error}}
                </div>
            {{/error}}

            <form action="{{baseUrl}}/usuario/procesarLogin" method="POST">
                <div class="mb-3">
                    <label for="nombre_usuario" class="form-label fw-semibold">Usuario</label>
                    <input
                        type="text"
                        class="form-control form-control-lg"
                        id="nombre_usuario"
                        name="nombre_usuario"
                        placeholder="Ingresá tu usuario"
                        required>
                </div>

                <div class="mb-4">
                    <label for="contrasena" class="form-label fw-semibold">Contraseña</label>
                    <input
                        type="password"
                        class="form-control form-control-lg"
                        id="contrasena"
                        name="contrasena"
                        placeholder="Ingresá tu contraseña"
                        required>
                </div>

                <button type="submit" class="btn btn-success btn-lg w-100 fw-bold">
                    Ingresar
                </button>
            </form>

            <div class="text-center mt-4">
                <p class="mb-1 text-muted">¿No tenés cuenta?</p>
                <a href="{{baseUrl}}/usuario/registro" class="fw-bold text-decoration-none">
                    Crear cuenta
                </a>
            </div>

            <button
                type="submit"
                class="auth-submit">

                Ingresar
            </button>

        </form>

        <div class="auth-secondary">
            <span>¿Todavía no tenés una cuenta?</span>

            <a href="{{baseUrl}}/usuario/registro">
                Crear cuenta
            </a>
        </div>

    </section>

</main>

</body>
</html>