{{>header}}

<main class="login-background min-vh-100 d-flex align-items-center justify-content-center px-3 py-3">
    <section class="card border-0 shadow-lg rounded-4 w-100 registro-card">
        <div class="card-body p-3 p-md-4">

            <div class="text-center mb-3 registro-header">
                <img src="/preguntadosPW2/img/logo.png"
                     alt="Preguntados Mundial"
                     class="logo-login mb-2">

                <h1 class="h4 fw-bold mb-1">Crear cuenta</h1>
                <p class="text-muted mb-0">Sumate al desafío mundialista 2026</p>
            </div>

            {{#error}}
                <div class="alert alert-danger text-center py-2">{{error}}</div>
            {{/error}}

            <form action="/preguntadosPW2/index.php?controller=usuario&method=registrar"
                  method="POST"
                  enctype="multipart/form-data">

                <div class="row registro-row">

                    <div class="col-12 col-md-4 mb-2">
                        <label class="form-label fw-semibold">Nombre completo</label>
                        <input type="text" class="form-control" name="nombre" placeholder="Ingresá tu nombre completo" required>
                    </div>

                    <div class="col-12 col-md-4 mb-2">
                        <label class="form-label fw-semibold">Usuario</label>
                        <input type="text" class="form-control" name="nombre_usuario" placeholder="Ingresá tu usuario" required>
                    </div>

                    <div class="col-12 col-md-4 mb-2">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" class="form-control" name="email" placeholder="Ingresá tu email" required>
                    </div>

                    <div class="col-6 col-md-4 mb-2">
                        <label class="form-label fw-semibold">Nacimiento</label>
                        <input type="date" class="form-control" name="fecha_nac" required>
                    </div>

                    <div class="col-6 col-md-4 mb-2">
                        <label class="form-label fw-semibold">Género</label>
                        <select class="form-select" name="genero" required>
                            <option value="">Seleccionar</option>
                            <option value="M">Masculino</option>
                            <option value="F">Femenino</option>
                            <option value="N">Prefiero no cargarlo</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-8 mb-2 ubicacion-registro">
                        <label class="form-label fw-semibold">Ubicación</label>

                        <div id="mapa"></div>

                        <input type="hidden"
                               name="coordenadas_ciudad"
                               id="coordenadas_ciudad"
                               required>
                    </div>

                    <div class="col-12 col-md-4 mb-2 foto-registro">
                        <label class="form-label fw-semibold">Foto de perfil</label>

                        <div class="foto-upload">
                            <div class="foto-preview" id="fotoPreview">
                                <img src="/preguntadosPW2/img/iconos/foto-perfil.png"
                                     alt="Foto de perfil"
                                     class="foto-icono">
                            </div>

                            <input type="file"
                                   id="fotoPerfil"
                                   name="foto_perfil"
                                   accept="image/*"
                                   hidden>

                            <button type="button"
                                    class="btn btn-outline-success btn-foto"
                                    onclick="document.getElementById('fotoPerfil').click()">
                                Seleccionar foto
                            </button>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 mb-2">
                        <label class="form-label fw-semibold">Contraseña</label>
                        <input type="password" class="form-control" name="contrasena" placeholder="Ingresá tu contraseña" required>
                    </div>

                    <div class="col-12 col-md-6 mb-3">
                        <label class="form-label fw-semibold">Confirmar contraseña</label>
                        <input type="password" class="form-control" name="confirmar_contrasena" placeholder="Repetí tu contraseña" required>
                    </div>

                </div>

                <div class="d-grid mt-2">
                    <button type="submit" class="btn btn-success fw-bold btn-crear">
                        Crear cuenta
                    </button>
                </div>

            </form>

            <div class="text-center mt-3">
                <span class="text-muted">¿Ya tenés cuenta?</span>
                <a href="/preguntadosPW2/index.php?controller=usuario&method=login"
                   class="fw-bold text-decoration-none">
                    Iniciar sesión
                </a>
            </div>

        </div>
    </section>
</main>

<script>
document.addEventListener('DOMContentLoaded', function () {

    const inputFoto = document.getElementById('fotoPerfil');
    const previewFoto = document.getElementById('fotoPreview');

    inputFoto.addEventListener('change', function () {
        const archivo = this.files[0];

        if (!archivo) return;

        const reader = new FileReader();

        reader.onload = function (e) {
            previewFoto.innerHTML = `<img src="${e.target.result}" alt="Preview">`;
        };

        reader.readAsDataURL(archivo);
    });

    const mapa = L.map('mapa').setView([-34.6037, -58.3816], 12);

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap'
    }).addTo(mapa);

    let marcador;

    mapa.on('click', function(e){
        if (marcador) {
            mapa.removeLayer(marcador);
        }

        marcador = L.marker(e.latlng).addTo(mapa);

        document.getElementById('coordenadas_ciudad').value =
            e.latlng.lat + ',' + e.latlng.lng;
    });

    setTimeout(function () {
        mapa.invalidateSize();
    }, 300);
});
</script>

{{>footer}}