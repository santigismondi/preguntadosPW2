<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Preguntados Mundial - Registro</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/preguntadosPW2/css/estilos.css">
</head>

<body>

<main class="login-background min-vh-100 d-flex align-items-center justify-content-center px-3 py-3">
    <section class="card border-0 shadow-lg rounded-4 w-100" style="max-width: 960px;">
        <div class="card-body p-3 p-md-4">

            <div class="text-center mb-2">
                <img src="/preguntadosPW2/img/logo.png"
                     alt="Preguntados Mundial"
                     class="logo-login mb-2">

                <h1 class="h4 fw-bold mb-1">Crear cuenta</h1>
                <p class="text-muted mb-0">Sumate al desafío mundialista 2026</p>
            </div>

            <form action="/usuario/registrar" method="POST" enctype="multipart/form-data">

                <div class="row">
                    <div class="col-12 col-md-4 mb-2">
                        <label class="form-label fw-semibold">Nombre completo</label>
                        <input type="text" class="form-control" name="nombre" required>
                    </div>

                    <div class="col-12 col-md-4 mb-2">
                        <label class="form-label fw-semibold">Usuario</label>
                        <input type="text" class="form-control" name="nombre_usuario" required>
                    </div>

                    <div class="col-12 col-md-4 mb-2">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" class="form-control" name="email" required>
                    </div>

                    <div class="col-6 col-md-4 mb-2">
                        <label class="form-label fw-semibold">Nacimiento</label>
                        <input type="date"
                               class="form-control"
                               name="fecha_nac"
                               required>
                    </div>

                    <div class="col-6 col-md-4 mb-2">
                        <label class="form-label fw-semibold">Género</label>
                        <select class="form-select"
                                name="genero"
                                required>

                            <option value="">Seleccionar</option>
                            <option value="M">Masculino</option>
                            <option value="F">Femenino</option>
                            <option value="X">Prefiero no cargarlo</option>

                        </select>
                    </div>

                    <div class="col-12 col-md-4 mb-2">
                        <label class="form-label fw-semibold">Foto de perfil</label>
                        <input type="file" class="form-control" name="foto_perfil" accept="image/*">
                    </div>

                    <div class="col-12 col-md-6 mb-2">
                        <label class="form-label fw-semibold">Contraseña</label>
                        <input type="password" class="form-control" name="contrasena" required>
                    </div>

                    <div class="col-12 col-md-6 mb-3">
                        <label class="form-label fw-semibold">Confirmar contraseña</label>
                        <input type="password" class="form-control" name="confirmar_contrasena" required>
                    </div>
                </div>

                <input type="hidden" name="coordenadas_ciudad" id="coordenadas_ciudad">

                <div class="d-grid mt-2">
                    <button type="submit" class="btn btn-success fw-bold">
                        Crear cuenta
                    </button>
                </div>

            </form>

            <div class="text-center mt-3">
                <span class="text-muted">¿Ya tenés cuenta?</span>
                <a href="/preguntadosPW2/index.php?controller=usuario&method=login"
                   class="fw-bold text-decoration-none">
                    Iniciar sesión
                </a>
            </div>

        </div>
    </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>