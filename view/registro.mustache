<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>{{titulo}}</title>
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

    <link
        rel="stylesheet"
        href="{{baseUrl}}/public/css/estilos.css">
</head>

<body class="auth-body">

<main class="auth-page auth-page--register">

    <section class="auth-card auth-card--register">

        <header class="auth-register-header">

            <div class="auth-logo-container auth-logo-container--small">
                <img
                        src="{{baseUrl}}/public/img/logo.png"
                        alt="Preguntados Mundial 2026"
                        class="auth-logo">
            </div>

            <div class="auth-register-copy">
                <span class="auth-eyebrow">
                    Nuevo jugador
                </span>

                <h1>Crear cuenta</h1>

                <p>
                    Registrate para jugar, sumar puntos y participar del ranking.
                </p>
            </div>

        </header>

        {{#error}}
            <div class="auth-alert" role="alert">
                {{error}}
            </div>
        {{/error}}

        <form
                action="{{baseUrl}}/usuario/registrar"
                method="POST"
                enctype="multipart/form-data"
                class="auth-form">

            <div class="auth-register-grid">

                <div class="auth-field">
                    <label for="nombre">
                        Nombre completo
                    </label>

                    <input
                            type="text"
                            id="nombre"
                            name="nombre"
                            placeholder="Ingresá tu nombre completo"
                            autocomplete="name"
                            required>
                </div>

                <div class="auth-field">
                    <label for="nombre_usuario">
                        Usuario
                    </label>

                    <input
                            type="text"
                            id="nombre_usuario"
                            name="nombre_usuario"
                            placeholder="Elegí un usuario"
                            autocomplete="username"
                            required>
                </div>

                <div class="auth-field">
                    <label for="email">
                        Correo electrónico
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Ingresá tu correo"
                        autocomplete="email"
                        required>
                </div>

                <div class="auth-field">
                    <label for="fecha_nac">
                        Fecha de nacimiento
                    </label>

                    <input
                        type="date"
                        id="fecha_nac"
                        name="fecha_nac"
                        required>
                </div>

                <div class="auth-field">
                    <label for="genero">
                        Género
                    </label>

                    <select
                        id="genero"
                        name="genero"
                        required>

                        <option value="">
                            Seleccioná una opción
                        </option>

                        <option value="M">
                            Masculino
                        </option>

                        <option value="F">
                            Femenino
                        </option>

                        <option value="N">
                            Prefiero no informarlo
                        </option>
                    </select>
                </div>

                <div class="auth-field auth-photo-field">
                    <label>
                        Foto de perfil
                    </label>

                    <div class="auth-photo-control">

                        <div
                            class="auth-photo-preview"
                            id="fotoPreview">

                            <img
                                src="{{baseUrl}}/public/img/usuarios/default.png"
                                alt="Vista previa de la foto">
                        </div>

                        <input
                            type="file"
                            id="fotoPerfil"
                            name="foto_perfil"
                            accept="image/jpeg,image/png,image/webp"
                            hidden>

                        <button
                            type="button"
                            class="auth-photo-button"
                            onclick="document.getElementById('fotoPerfil').click()">

                            Seleccionar imagen
                        </button>

                    </div>
                </div>

                <div class="auth-field auth-map-field">

                    <label>
                        Ubicación
                    </label>

                    <small>
                        Hacé clic sobre el mapa para indicar tu ciudad.
                    </small>

                    <div
                        id="mapa"
                        class="auth-map">
                    </div>

                    <input
                        type="hidden"
                        name="coordenadas_ciudad"
                        id="coordenadas_ciudad">
                </div>

                <div class="auth-passwords">

                    <div class="auth-field">
                        <label for="contrasena">
                            Contraseña
                        </label>

                        <input
                            type="password"
                            id="contrasena"
                            name="contrasena"
                            placeholder="Ingresá una contraseña"
                            autocomplete="new-password"
                            required>
                    </div>

                    <div class="auth-field">
                        <label for="confirmar_contrasena">
                            Confirmar contraseña
                        </label>

                        <input
                            type="password"
                            id="confirmar_contrasena"
                            name="confirmar_contrasena"
                            placeholder="Repetí la contraseña"
                            autocomplete="new-password"
                            required>
                    </div>

                </div>

            </div>

            <button
                type="submit"
                class="auth-submit auth-submit--register">

                Crear cuenta
            </button>

        </form>

        <div class="auth-secondary">
            <span>¿Ya tenés una cuenta?</span>

            <a href="{{baseUrl}}/usuario/login">
                Iniciar sesión
            </a>
        </div>

    </section>

</main>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const inputFoto =
        document.getElementById("fotoPerfil");

    const previewFoto =
        document.getElementById("fotoPreview");

    if (inputFoto && previewFoto) {
        inputFoto.addEventListener("change", function () {

            const archivo = this.files[0];

            if (!archivo) {
                return;
            }

            const reader = new FileReader();

            reader.onload = function (evento) {
                previewFoto.innerHTML =
                    '<img src="' +
                    evento.target.result +
                    '" alt="Vista previa de la foto">';
            };

            reader.readAsDataURL(archivo);
        });
    }

    const mapaContainer =
        document.getElementById("mapa");

    const coordenadasInput =
        document.getElementById("coordenadas_ciudad");

    if (
        mapaContainer &&
        coordenadasInput &&
        typeof L !== "undefined"
    ) {
        const mapa = L.map("mapa").setView(
            [-34.6037, -58.3816],
            10
        );

        L.tileLayer(
            "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                attribution: "&copy; OpenStreetMap"
            }
        ).addTo(mapa);

        let marcador = null;

            mapa.on("click", function (evento) {

            if (marcador) {
                mapa.removeLayer(marcador);
            }

            marcador =
                L.marker(evento.latlng).addTo(mapa);

            coordenadasInput.value =
                evento.latlng.lat +
                "," +
                evento.latlng.lng;
        });

        setTimeout(function () {
            mapa.invalidateSize();
        }, 250);
    }

});
</script>

</body>
</html>