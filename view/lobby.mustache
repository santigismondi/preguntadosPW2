{{>header}}

<div class="overlay"></div>

<div class="contenido">
    <h1 class="titulo">⚽ Preguntados Mundial 2026</h1>

    <p class="bienvenida">
        Bienvenido, <strong>{{nombre_usuario}}</strong>. ¡Preparado para jugar!
    </p>

    <div class="puntaje-display">⭐ Puntaje: {{puntaje}}</div>

    <div class="alert alert-warning text-center mb-3">
        🏆 Mejor puntaje: <strong>{{puntajeMaximo}}</strong>
    </div>

    <div class="alert alert-info text-center mb-3">
        🏆 Ranking global
        <br>
        Tu posición: <strong>#{{posicionRanking}}</strong>
        <br><br>
        <a href="{{baseUrl}}/ranking/ver" class="btn btn-warning">
            Ver ranking completo
        </a>
    </div>

    {{#partidaTerminada}}
    <div class="modal-gameover" id="modalGameover">
        <div class="modal-contenido">
            <h2>💥 ¡Partida terminada!</h2>

            <p>
                Obtuviste <strong>{{puntajeFinal}}</strong> punto{{#puntajeFinal}}s{{/puntajeFinal}}
            </p>

            <p class="respuesta-info">
                La respuesta correcta era:<br>
                <strong>{{respuestaCorrecta}}</strong>
            </p>

            <button class="btn-girar" onclick="document.getElementById('modalGameover').style.display='none'">
                Cerrar
            </button>
        </div>
    </div>
    {{/partidaTerminada}}

    <div class="acciones-lobby">
    <a href="{{baseUrl}}/lobby/jugar" class="btn-jugar">
        🎮 Jugar
    </a>

    <a href="{{baseUrl}}/pregunta/proponer" class="btn-jugar">
        ➕ Proponer pregunta
    </a>
</div>
</div>

{{>footer}}