{{>header}}

<div class="overlay"></div>

<main class="contenido lobby-page">
    <section class="hero-card">
        <div class="hero-copy">
            <span class="eyebrow">Edición mundial</span>
            <h1 class="titulo">Preguntados Mundial 2026</h1>
            <p class="bienvenida">
                Bienvenido, <strong>{{nombre_usuario}}</strong>. Demostrá cuánto sabés de fútbol y competí en el ranking.
            </p>
        </div>

        <div class="score-card">
    <span>Tu puntaje</span>
    <strong>{{puntaje}}</strong>
    <small>puntos actuales</small>
</div>
    </section>

    <section class="stats-grid">
        <article class="stat-card">
            <span>Mejor puntaje</span>
            <strong>{{puntajeMaximo}}</strong>
        </article>

        <article class="stat-card">
            <span>Ranking global</span>
            <strong>#{{posicionRanking}}</strong>
            <a href="{{baseUrl}}/ranking/ver">Ver ranking completo</a>
        </article>
    </section>

    {{#partidaTerminada}}
<div class="modal-gameover" id="modalGameover">
    <div class="modal-contenido">
        <span class="eyebrow">Partida finalizada</span>

        <h2>Terminó la partida</h2>

        <p>
            Obtuviste <strong>{{puntajeFinal}}</strong> puntos.
        </p>

        <a href="{{baseUrl}}/lobby/ver" class="btn-jugar">
            Volver al lobby
        </a>
    </div>
</div>
{{/partidaTerminada}}

    <section class="acciones-lobby">
        <a href="{{baseUrl}}/lobby/jugar" class="btn-jugar btn-jugar--primary">
            Jugar ahora
        </a>

        <a href="{{baseUrl}}/pregunta/proponer" class="btn-jugar btn-jugar--secondary">
            Proponer pregunta
        </a>
    </section>
</main>

{{>footer}}