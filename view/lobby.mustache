{{>header}}

<div class="overlay"></div>

<div class="contenido">
    <h1 class="titulo">⚽ Preguntados Mundial 2026</h1>
    <p class="bienvenida">Bienvenido, <strong>{{nombre_usuario}}</strong>. ¡Girá la ruleta para elegir tu categoría!</p>

    <div class="ruleta-wrapper">
        <div class="flecha">▼</div>
        <canvas id="ruleta" width="400" height="400"></canvas>
    </div>

    <button class="btn-girar" id="btnGirar" onclick="girarRuleta()">
        🎲 Girar ruleta
    </button>

    <div class="resultado" id="resultado"></div>

    <div class="logout">
        <a href="/preguntadosPW2/index.php?controller=usuario&method=logout">Cerrar sesión</a>
    </div>
</div>

<script>
const categorias = [
    {{#categorias}}
    { id: "{{id}}", nombre: "{{nombre}}", color: "{{color}}" },
    {{/categorias}}
];

const canvas = document.getElementById('ruleta');
const ctx = canvas.getContext('2d');
const cx = canvas.width / 2;
const cy = canvas.height / 2;
const radio = cx - 10;

let anguloActual = 0;
let girando = false;

function dibujarRuleta(angulo) {
    const total = categorias.length;
    const slice = (2 * Math.PI) / total;

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    categorias.forEach((cat, i) => {
        const inicio = angulo + i * slice;
        const fin = inicio + slice;

        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.arc(cx, cy, radio, inicio, fin);
        ctx.closePath();
        ctx.fillStyle = cat.color;
        ctx.fill();
        ctx.strokeStyle = '#fff';
        ctx.lineWidth = 2;
        ctx.stroke();

        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(inicio + slice / 2);
        ctx.textAlign = 'right';
        ctx.fillStyle = '#fff';
        ctx.font = 'bold 13px Arial';
        ctx.shadowColor = '#000';
        ctx.shadowBlur = 4;
        ctx.fillText(cat.nombre, radio - 10, 5);
        ctx.restore();
    });
}

function girarRuleta() {
    if (girando) return;
    girando = true;

    const btn = document.getElementById('btnGirar');
    btn.disabled = true;
    document.getElementById('resultado').textContent = '';

    const vueltasExtra = (Math.random() * 4 + 6) * 2 * Math.PI;
    const anguloFinal = anguloActual + vueltasExtra;
    const duracion = 4000;
    const inicio = performance.now();
    const anguloInicio = anguloActual;

    function animar(ahora) {
        const transcurrido = ahora - inicio;
        const progreso = Math.min(transcurrido / duracion, 1);
        const ease = 1 - Math.pow(1 - progreso, 3);

        anguloActual = anguloInicio + vueltasExtra * ease;
        dibujarRuleta(anguloActual);

        if (progreso < 1) {
            requestAnimationFrame(animar);
        } else {
            girando = false;
            btn.disabled = false;

            const slice = (2 * Math.PI) / categorias.length;
            const flechaAngulo = (3 * Math.PI) / 2;
            const angNorm = ((flechaAngulo - anguloActual) % (2 * Math.PI) + 2 * Math.PI) % (2 * Math.PI);
            const indice = Math.floor(angNorm / slice) % categorias.length;

            document.getElementById('resultado').textContent = '¡Te tocó: ' + categorias[indice].nombre + '!';
        }
    }

    requestAnimationFrame(animar);
}

dibujarRuleta(anguloActual);
</script>

{{>footer}}
