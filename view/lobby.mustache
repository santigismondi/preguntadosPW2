<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Lobby — Preguntados Mundial 2026</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/lobby.css">
</head>
<body>

    <div class="overlay"></div>

    <div class="contenido">

        <h1 class="titulo">⚽ Preguntados Mundial 2026</h1>
        <p class="bienvenida">Bienvenido, <strong>{{nombre_usuario}}</strong>. ¡Tocá el botón para elegir tu categoría!</p>

        <div class="categorias-grid" id="grid-categorias">
            {{#categorias}}
            <div class="categoria-card" id="cat-{{id}}" style="background-color: {{color}};">
                {{nombre}}
            </div>
            {{/categorias}}
        </div>

        <button class="btn-girar" id="btnGirar" onclick="elegirCategoria()">
            🎲 Elegir categoría
        </button>

        <div class="resultado" id="resultado"></div>

        <div class="logout">
            <a href="index.php?controller=usuario&method=logout">Cerrar sesión</a>
        </div>

    </div>

    <script>
        const categorias = [
            {{#categorias}}
            { id: "{{id}}", nombre: "{{nombre}}" },
            {{/categorias}}
        ];

        let animando = false;

        function elegirCategoria() {
            if (animando) return;
            animando = true;

            const btn = document.getElementById('btnGirar');
            btn.disabled = true;
            document.getElementById('resultado').textContent = '';

            // Resetear todas las cards
            categorias.forEach(c => {
                const card = document.getElementById('cat-' + c.id);
                card.classList.remove('seleccionada', 'no-seleccionada');
            });

            // Elegir ganadora aleatoriamente
            const indiceGanador = Math.floor(Math.random() * categorias.length);

            // Animación: parpadeo recorriendo categorías
            let i = 0;
            const totalParpadeos = 20 + indiceGanador;
            let delay = 80;

            function paso() {
                // Limpiar anterior
                categorias.forEach(c => {
                    document.getElementById('cat-' + c.id).classList.remove('seleccionada');
                });

                // Marcar actual
                const actual = categorias[i % categorias.length];
                document.getElementById('cat-' + actual.id).classList.add('seleccionada');

                i++;
                delay = Math.min(delay + 8, 400);

                if (i <= totalParpadeos) {
                    setTimeout(paso, delay);
                } else {
                    // Terminar en la ganadora
                    categorias.forEach(c => {
                        const card = document.getElementById('cat-' + c.id);
                        card.classList.remove('seleccionada');
                        card.classList.add('no-seleccionada');
                    });
                    const ganadora = categorias[indiceGanador];
                    const cardGanadora = document.getElementById('cat-' + ganadora.id);
                    cardGanadora.classList.remove('no-seleccionada');
                    cardGanadora.classList.add('seleccionada');

                    document.getElementById('resultado').textContent = '¡Te tocó: ' + ganadora.nombre + '!';
                    btn.disabled = false;
                    animando = false;

                    setTimeout(() => {
                        window.location.href = 'index.php?controller=juego&method=jugar&categoria_id=' + ganadora.id;
                    }, 1500);
                }
            }

            paso();
        }
    </script>

</body>
</html>