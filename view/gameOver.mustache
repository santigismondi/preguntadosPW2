{{>header}}

<div class="overlay"></div>

<main class="gameover-page">
    <section class="gameover-card">
        <span class="gameover-label">Partida finalizada</span>

        <h1>No alcanzó esta vez</h1>

        <p class="gameover-message">
            {{error}}
        </p>

        <div class="gameover-score">
            <span>Puntaje final</span>
            <strong>{{puntajeFinal}}</strong>
            <small>puntos</small>
        </div>

        <a href="{{baseUrl}}/lobby/ver" class="gameover-button">
    Volver al lobby
</a>
    </section>
</main>

{{>footer}}