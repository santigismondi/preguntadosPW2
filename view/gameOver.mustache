<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>¡Game Over! — Preguntados</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #111; color: white; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .card-error { background: #222; border: 2px solid #e74c3c; border-radius: 15px; padding: 40px; width: 100%; max-width: 500px; text-align: center; box-shadow: 0 0 20px rgba(231, 76, 60, 0.4); }
    </style>
</head>
<body>

<div class="card-error">
    <h1 class="display-4 text-danger fw-bold mb-3">❌ ¡Perdiste!</h1>
    <p class="fs-5 mb-4">{{error}}</p>

    <div class="mb-4">
        <p class="text-muted m-0">Tu puntaje total quedó en:</p>
        <h3 class="text-warning fw-bold">{{puntajeFinal}} Puntos</h3>
    </div>

    <a href="index.php?controller=lobby&method=ver" class="btn btn-danger btn-lg w-100 fw-bold py-3">
        Volver al Lobby a girar
    </a>
</div>

</body>
</html>