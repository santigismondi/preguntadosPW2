{{>header}}

<main class="pregunta-page" style="background-color: {{colorCategoria}};">

    <section class="pregunta-container">

        <div class="pregunta-meta">
            <div class="pregunta-meta-badge" style="--badge-contrast: {{headerCategoryContrastColor}}; color: {{headerCategoryContrastColor}};">
                <span style="color: {{headerCategoryContrastColor}};">⭐ <strong class="puntaje-numero" style="color: {{headerCategoryContrastColor}};">{{puntaje}}</strong></span>
                <span style="color: {{headerCategoryContrastColor}};">⏱ <strong id="timer" class="puntaje-numero" style="color: {{headerCategoryContrastColor}};">10</strong></span>
            </div>
        </div>

        <article class="pregunta-card">
            <h2>{{preguntaTexto}}</h2>
        </article>

        <div class="respuestas-container">
            {{#opciones}}
                <button type="button"
                        class="respuesta-btn"
                        data-opcion-id="{{id}}"
                        onclick="responder(this, '{{id}}')">
                    {{texto}}
                </button>
            {{/opciones}}
        </div>

    </section>

</main>

<script>
    let respondido = false;

    function responder(boton, opcionId) {
        if (respondido) return;
        respondido = true;

        const botones = document.querySelectorAll('.respuesta-btn');
        botones.forEach(b => b.disabled = true);

        const datos = new FormData();
        datos.append('pregunta_id', '{{preguntaId}}');
        datos.append('opcion_id', opcionId);
        datos.append('categoria_id', '{{categoriaId}}');

        fetch('index.php?controller=pregunta&method=verificar', {
            method: 'POST',
            body: datos
        })
        .then(r => r.json())
        .then(data => {
            const correctaBtn = document.querySelector('[data-opcion-id="' + data.correctaId + '"]');

            if (data.correcta) {
                boton.classList.add('respuesta-correcta');
            } else {
                boton.classList.add('respuesta-incorrecta');
                if (correctaBtn) {
                    correctaBtn.classList.add('respuesta-correcta');
                }
            }

            setTimeout(function() {
                window.location.href = data.redirect;
            }, 1500);
        });
    }
</script>

<script>
    let tiempoRestante = 10;

    const timer = document.getElementById('timer');

    const intervalo = setInterval(() => {

        if (respondido) {
            clearInterval(intervalo);
            return;
        }

        tiempoRestante--;
        timer.textContent = tiempoRestante;

        if (tiempoRestante <= 0) {
            clearInterval(intervalo);

            window.location.href =
                    '{{baseUrl}}/pregunta/timeout?categoria_id={{categoriaId}}';
        }

    }, 1000);
</script>

{{>footer}}
