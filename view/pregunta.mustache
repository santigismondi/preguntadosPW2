{{>header}}

<div class="overlay"></div>

<main class="contenido pregunta-page">

    <section class="pregunta-shell" style="--categoria-color: {{colorCategoria}};">

        <div class="pregunta-top">
            <div class="categoria-chip">
                <img src="{{iconoCategoria}}" alt="{{nombreCategoria}}">
                <div>
                    <span>Categoría</span>
                    <strong>{{nombreCategoria}}</strong>
                </div>
            </div>

            <div class="pregunta-meta">
                <div class="meta-pill">
                    <span>Puntaje</span>
                    <strong>{{puntaje}}</strong>
                </div>

                <div class="meta-pill">
                    <span>Tiempo</span>
                    <strong id="timer">10</strong>
                </div>
            </div>
        </div>

        <article class="pregunta-card">
            <span class="eyebrow">Pregunta</span>
            <h2>{{preguntaTexto}}</h2>
        </article>

        <div class="respuestas-container">
            {{#opciones}}
            <button
                type="button"
                class="respuesta-btn"
                data-opcion-id="{{id}}"
                onclick="responder(this, '{{id}}')">

                {{texto}}
            </button>
            {{/opciones}}
        </div>
    </section>

    <!-- Modal de Reporte -->
    <div id="modalReporte" class="modal-reporte" aria-hidden="true">
        <div class="modal-reporte-contenido">
            <h3>Reportar pregunta</h3>

            <p>
                Contanos por qué esta pregunta debería ser revisada.
            </p>

            <textarea
                    id="motivoReporte"
                    placeholder="Ejemplo: la respuesta correcta está mal, la pregunta está repetida, etc."></textarea>

            <p id="mensajeReporte" class="mensaje-reporte"></p>

            <div class="modal-reporte-acciones">
                <button
                        type="button"
                        onclick="cerrarModalReporte()"
                        class="btn-modal-cancelar">

                    Cancelar
                </button>

                <button
                        type="button"
                        id="btnEnviarReporte"
                        onclick="enviarReportePregunta()"
                        class="btn-modal-enviar">

                    Enviar reporte
                </button>
            </div>
        </div>
    </div>
</main>

<!-- Popup de Resultado -->
<div class="answer-popup" id="answerPopup" aria-hidden="true">
    <div class="answer-popup__card" id="answerPopupCard">

        <span class="answer-popup__label">
            Resultado
        </span>

        <strong id="answerPopupTitle"></strong>

        <p id="answerPopupMessage"></p>

        <div class="answer-popup__actions">

            <button
                    type="button"
                    class="btn-reportar-pregunta"
                    onclick="reportarPregunta()">

                Reportar pregunta
            </button>

            <button
                    type="button"
                    class="btn-continuar-respuesta"
                    onclick="continuarRespuesta()">

                Continuar
            </button>

        </div>
    </div>
</div>

<script>
    // Variables globales unificadas
    let respondido = false;
    let reportando = false;
    let redirectTimeout = null;
    let redirectRespuesta = null;
    let tiempoRestante = Number({{tiempoRestante}});

    const timer = document.getElementById("timer");
    const botonesRespuesta = document.querySelectorAll(".respuesta-btn");

    timer.textContent = String(tiempoRestante).padStart(2, "0");

    const intervaloPregunta = setInterval(function () {
        if (respondido) {
            clearInterval(intervaloPregunta);
            return;
        }

        tiempoRestante--;

        timer.textContent = String(
                Math.max(tiempoRestante, 0)
        ).padStart(2, "0");

        if (tiempoRestante <= 0) {
            clearInterval(intervaloPregunta);
            respondido = true;

            window.location.href =
                    "{{baseUrl}}/pregunta/timeout?categoria_id={{categoriaId}}";
        }
    }, 1000);


    function mostrarResultado(esCorrecta) {
        const popup = document.getElementById("answerPopup");
        const popupCard = document.getElementById("answerPopupCard");
        const popupTitle = document.getElementById("answerPopupTitle");
        const popupMessage = document.getElementById("answerPopupMessage");

        popupCard.classList.remove(
                "answer-popup__card--correct",
                "answer-popup__card--wrong"
        );

        if (esCorrecta) {
            popupCard.classList.add(
                    "answer-popup__card--correct"
            );

            popupTitle.textContent =
                    "Respuesta correcta";

            popupMessage.textContent =
                    "Sumaste un punto. Podés continuar o reportar la pregunta.";
        } else {
            popupCard.classList.add(
                    "answer-popup__card--wrong"
            );

            popupTitle.textContent =
                    "Respuesta incorrecta";

            popupMessage.textContent =
                    "La partida terminó. Podés continuar o reportar la pregunta.";
        }

        popup.classList.add(
                "answer-popup--visible"
        );

        popup.setAttribute(
                "aria-hidden",
                "false"
        );
    }


    function responder(boton, opcionId) {
        if (respondido) {
            return;
        }

        respondido = true;

        clearInterval(intervaloPregunta);

        botonesRespuesta.forEach(function (botonRespuesta) {
            botonRespuesta.disabled = true;
        });

        const datos = new FormData();

        datos.append(
                "pregunta_id",
                "{{preguntaId}}"
        );

        datos.append(
                "opcion_id",
                opcionId
        );

        datos.append(
                "categoria_id",
                "{{categoriaId}}"
        );

        fetch(
                "{{baseUrl}}/pregunta/verificar",
                {
                    method: "POST",
                    body: datos
                }
        )
                .then(async function (respuesta) {
                    const textoRespuesta =
                            await respuesta.text();

                    let data;

                    try {
                        data = JSON.parse(
                                textoRespuesta
                        );
                    } catch (error) {
                        console.error(
                                "Respuesta no JSON:",
                                textoRespuesta
                        );

                        throw new Error(
                                "El servidor devolvió una respuesta inválida."
                        );
                    }

                    if (!respuesta.ok || data.error) {
                        throw new Error(
                                data.mensaje ||
                                "No se pudo verificar la respuesta."
                        );
                    }

                    return data;
                })
                .then(function (data) {
                    redirectRespuesta = data.redirect;

                    const botonCorrecto =
                            document.querySelector(
                                    '[data-opcion-id="' +
                                    data.correctaId +
                                    '"]'
                            );

                    if (data.correcta) {
                        boton.classList.add(
                                "respuesta-correcta"
                        );
                    } else {
                        boton.classList.add(
                                "respuesta-incorrecta"
                        );

                        if (botonCorrecto) {
                            botonCorrecto.classList.add(
                                    "respuesta-correcta"
                            );
                        }
                    }

                    setTimeout(function () {
                        mostrarResultado(
                                data.correcta
                        );
                    }, 900);

                    redirectTimeout =
                            setTimeout(function () {
                                if (!reportando &&
                                        redirectRespuesta) {

                                    window.location.href =
                                            redirectRespuesta;
                                }
                            }, 10000);
                })
                .catch(function (error) {
                    console.error(
                            "Error al verificar:",
                            error
                    );

                    respondido = false;

                    botonesRespuesta.forEach(
                            function (botonRespuesta) {
                                botonRespuesta.disabled = false;
                            }
                    );

                    alert(error.message);
                });
    }


    function reportarPregunta() {
        reportando = true;

        clearTimeout(
                redirectTimeout
        );

        const popup =
                document.getElementById(
                        "answerPopup"
                );

        const modal =
                document.getElementById(
                        "modalReporte"
                );

        const textarea =
                document.getElementById(
                        "motivoReporte"
                );

        const mensaje =
                document.getElementById(
                        "mensajeReporte"
                );

        mensaje.textContent = "";

        popup.classList.remove(
                "answer-popup--visible"
        );

        popup.setAttribute(
                "aria-hidden",
                "true"
        );

        modal.classList.add(
                "modal-reporte-activo"
        );

        modal.setAttribute(
                "aria-hidden",
                "false"
        );

        setTimeout(function () {
            textarea.focus();
        }, 100);
    }


    function cerrarModalReporte() {
        reportando = false;

        const modal =
                document.getElementById(
                        "modalReporte"
                );

        const popup =
                document.getElementById(
                        "answerPopup"
                );

        modal.classList.remove(
                "modal-reporte-activo"
        );

        modal.setAttribute(
                "aria-hidden",
                "true"
        );

        popup.classList.add(
                "answer-popup--visible"
        );

        popup.setAttribute(
                "aria-hidden",
                "false"
        );

        redirectTimeout =
                setTimeout(function () {
                    if (redirectRespuesta) {
                        window.location.href =
                                redirectRespuesta;
                    }
                }, 10000);
    }


    function continuarRespuesta() {
        clearTimeout(
                redirectTimeout
        );

        if (redirectRespuesta) {
            window.location.href =
                    redirectRespuesta;
        }
    }


    function enviarReportePregunta() {
        const motivoInput =
                document.getElementById(
                        "motivoReporte"
                );

        const mensajeReporte =
                document.getElementById(
                        "mensajeReporte"
                );

        const botonEnviar =
                document.getElementById(
                        "btnEnviarReporte"
                );

        const motivo =
                motivoInput.value.trim();

        mensajeReporte.textContent = "";
        mensajeReporte.classList.remove(
                "mensaje-reporte--error"
        );

        if (motivo.length < 3) {
            mensajeReporte.textContent =
                    "Escribí un motivo de al menos 3 caracteres.";

            mensajeReporte.classList.add(
                    "mensaje-reporte--error"
            );

            return;
        }

        botonEnviar.disabled = true;
        botonEnviar.textContent =
                "Enviando...";

        const datos = new FormData();

        datos.append(
                "pregunta_id",
                "{{preguntaId}}"
        );

        datos.append(
                "motivo",
                motivo
        );

        fetch(
                "{{baseUrl}}/pregunta/reportar",
                {
                    method: "POST",
                    body: datos
                }
        )
                .then(async function (respuesta) {
                    const textoRespuesta =
                            await respuesta.text();

                    let data;

                    try {
                        data = JSON.parse(
                                textoRespuesta
                        );
                    } catch (error) {
                        console.error(
                                "Respuesta no JSON:",
                                textoRespuesta
                        );

                        throw new Error(
                                "El servidor devolvió una respuesta inválida."
                        );
                    }

                    if (!respuesta.ok || !data.ok) {
                        throw new Error(
                                data.mensaje ||
                                "No se pudo guardar el reporte."
                        );
                    }

                    return data;
                })
                .then(function () {
                    mostrarReporteEnviado();
                })
                .catch(function (error) {
                    console.error(
                            "Error enviando reporte:",
                            error
                    );

                    mensajeReporte.textContent =
                            error.message;

                    mensajeReporte.classList.add(
                            "mensaje-reporte--error"
                    );

                    botonEnviar.disabled = false;
                    botonEnviar.textContent =
                            "Enviar reporte";
                });
    }


    function mostrarReporteEnviado() {
        const contenido =
                document.querySelector(
                        ".modal-reporte-contenido"
                );

        contenido.innerHTML = `
        <div class="modal-reporte-exito">

            <div class="icono-reporte-exito">
                ✅
            </div>

            <h3>
                ¡Reporte enviado!
            </h3>

            <p>
                Gracias por ayudarnos a mejorar el juego.
                La pregunta será revisada por un editor.
            </p>

            <button
                type="button"
                class="btn-modal-continuar"
                onclick="finalizarReporte()">

                Continuar
            </button>

        </div>
    `;
    }


    function finalizarReporte() {
        window.location.href =
                redirectRespuesta ||
                "{{baseUrl}}/lobby/ver";
    }
</script>

{{>footer}}