{{>header}}

<div class="overlay"></div>

<div class="contenido">
    <h1 class="titulo">➕ Proponer pregunta</h1>

    <p class="bienvenida">
        Cargá una pregunta nueva. Quedará pendiente hasta que un editor la apruebe.
    </p>

    {{#mensaje}}
    <div class="alert alert-info text-center mb-3">
        {{mensaje}}
    </div>
    {{/mensaje}}

    <form method="POST" action="{{baseUrl}}/pregunta/guardarPropuesta" class="form-pregunta">
        <label>Pregunta</label>
        <input type="text" name="texto" required placeholder="Ej: ¿Quién ganó el Mundial 2022?">

        <label>Categoría</label>
        <select name="categoria_id" required>
            <option value="">Seleccioná una categoría</option>
            {{#categorias}}
                <option value="{{id}}">{{nombre}}</option>
            {{/categorias}}
        </select>

        <label>Opción 1</label>
        <input type="text" name="opcion_1" required>
        <label>
            <input type="radio" name="correcta" value="0" required>
            Esta es la correcta
        </label>

        <label>Opción 2</label>
        <input type="text" name="opcion_2" required>
        <label>
            <input type="radio" name="correcta" value="1">
            Esta es la correcta
        </label>

        <label>Opción 3</label>
        <input type="text" name="opcion_3" required>
        <label>
            <input type="radio" name="correcta" value="2">
            Esta es la correcta
        </label>

        <label>Opción 4</label>
        <input type="text" name="opcion_4" required>
        <label>
            <input type="radio" name="correcta" value="3">
            Esta es la correcta
        </label>

        <button type="submit" class="btn-girar">
            Enviar pregunta
        </button>

        <a href="{{baseUrl}}/lobby/ver" class="btn-jugar">
            Volver al lobby
        </a>
    </form>
</div>

{{>footer}}